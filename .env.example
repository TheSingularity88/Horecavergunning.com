# ============================================================
# Horecavergunningen.com — environment variables
# Copy to .env.local for local dev; set the same in Vercel.
# NEXT_PUBLIC_* vars are exposed to the browser — never put
# secrets in them.
# ============================================================

# --- Supabase (public, safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (SERVER ONLY — bypasses RLS, keep secret) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
# Used for Mollie redirect/webhook URLs and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxx
# Verified sender. During development you can use onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where owner notifications (new leads, new requests, payments) go.
OWNER_NOTIFICATION_EMAIL=you@example.com

# --- Mollie (payments) ---
# Use a test_ key until go-live.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxx
